#!/bin/bash
set -euo pipefail

STAGING="{{ backup_staging_dir }}"
CONFIG="{{ backup_rclone_config }}"
REMOTE="{{ backup_remote }}"
DB="{{ uptime_kuma_data_dir }}/kuma.db"
STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
OUT="${STAGING}/kuma-${STAMP}.db"

if [[ ! -f "${DB}" ]]; then
  echo "database not found at ${DB}" >&2
  exit 1
fi

sqlite3 "${DB}" ".backup '${OUT}'"

rclone --config "${CONFIG}" copyto "${OUT}" "${REMOTE}/kuma-${STAMP}.db"

rm -f "${OUT}"
echo "uploaded kuma-${STAMP}.db to ${REMOTE}"
