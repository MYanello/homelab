#!/usr/bin/env bash
# Keep the tunnel pointed at the current address of the dynamic home endpoint.
# wg-quick resolves the endpoint once at start-up; this re-resolves it on a timer.
set -euo pipefail

interface="{{ wireguard_gateway_interface }}"
endpoint_host="{{ wireguard_gateway_endpoint }}"
endpoint_port="{{ wireguard_gateway_endpoint_port }}"
peer_public_key="{{ wireguard_gateway_peer_public_key }}"

current="$(wg show "$interface" endpoints 2>/dev/null | awk -v key="$peer_public_key" '$1 == key { print $2 }')"

# Interface is down or the peer is not configured yet: nothing to update.
if [ -z "$current" ] || [ "$current" = "(none)" ]; then
  exit 0
fi

resolved="$(getent ahostsv4 "$endpoint_host" | awk 'NR == 1 { print $1 }')"
if [ -z "$resolved" ]; then
  echo "failed to resolve $endpoint_host" >&2
  exit 1
fi

desired="$resolved:$endpoint_port"
if [ "$current" = "$desired" ]; then
  exit 0
fi

wg set "$interface" peer "$peer_public_key" endpoint "$desired"
echo "updated $interface peer endpoint: $current -> $desired"
