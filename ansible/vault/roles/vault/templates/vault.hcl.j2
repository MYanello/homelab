ui = true
disable_mlock = true

api_addr     = "https://{{ vault_hostname }}:8200"
cluster_addr = "https://{{ hostvars[inventory_hostname].ansible_host }}:8201"

listener "tcp" {
  address                 = "0.0.0.0:8200"
  tls_cert_file           = "{{ vault_tls_dir }}/tls.crt"
  tls_key_file            = "{{ vault_tls_dir }}/tls.key"
  tls_disable_client_certs = "true"

  max_request_size         = 1048576
  max_request_duration     = "30s"
  max_token_header_size    = 4096
  http_read_header_timeout = "5s"
  http_write_timeout       = "30s"
  http_idle_timeout        = "60s"

  x_forwarded_for_authorized_addrs      = "{{ groups['k3s'] | map('extract', hostvars, 'ansible_host') | join(',') }}"
  x_forwarded_for_reject_not_authorized = true

  telemetry {
    unauthenticated_metrics_access = true
  }
}

storage "raft" {
  path    = "{{ vault_data_dir }}"
  node_id = "vault"
}

seal "ocikms" {
  auth_type_api_key   = "true"
  crypto_endpoint     = "{{ vault_ocikms_crypto_endpoint }}"
  management_endpoint = "{{ vault_ocikms_management_endpoint }}"
  key_id              = "{{ vault_ocikms_seal_key_id }}"
}

telemetry {
  prometheus_retention_time = "60s"
  disable_hostname          = true
}
