{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "ignorePaths": [
    "argocd/dev/**",
    "argocd/infra/system-upgrade-controller/plans/**"
  ],
  "argocd": {
    "managerFilePatterns": ["argocd/**/*.yaml$", "talos/**/*.yaml$"]
  },
  "kubernetes": {
    "managerFilePatterns": ["argocd/**/*.yaml", "talos/**/*.yaml"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update GitHub release asset references in YAML manifests",
      "managerFilePatterns": ["**/*.yaml", "**/*.yml"],
      "matchStrings": [
        "https:\\/\\/github\\.com\\/(?<depName>[^\\/\\s]+\\/[^\\/\\s]+)\\/releases\\/download\\/(?<currentValue>[\\w.\\-]+)\\/"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update GitHub tag references in YAML manifests",
      "managerFilePatterns": ["**/*.yaml", "**/*.yml"],
      "matchStrings": [
        "https:\\/\\/raw\\.githubusercontent\\.com\\/(?<depName>[^\\/\\s]+\\/[^\\/\\s]+)\\/(?<currentValue>[\\w.\\-]+)\\/"
      ],
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["harbor.yanello.net/ghcr/hotio/prowlarr"],
      "versioning": "regex:^release-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$",
      "allowedVersions": "/^release-[0-9]+\\.[0-9]+/"
    },
    {
      "groupName": "victoria-metrics and CRDS move together",
      "matchDatasources": ["helm"],
      "matchPackageNames": [
        "victoria-metrics-k8s-stack",
        "victoria-metrics-operator-crds"
      ]
    }
  ]
}
