diff --git a/argocd/paperless/manifests/netpol.yaml b/argocd/paperless/manifests/netpol.yaml
index 28c9e2b8..fb53794e 100644
--- a/argocd/paperless/manifests/netpol.yaml
+++ b/argocd/paperless/manifests/netpol.yaml
@@ -15,6 +15,17 @@ spec:
             - port: "8000"
               protocol: TCP
   egress:
+    # DNS, so the bridge sidecar can resolve Proton's API hosts.
+    - toEndpoints:
+        - matchLabels:
+            k8s:io.kubernetes.pod.namespace: kube-system
+            k8s:k8s-app: kube-dns
+      toPorts:
+        - ports:
+            - port: "53"
+              protocol: UDP
+            - port: "53"
+              protocol: TCP
     - toEndpoints:
         - matchLabels:
             k8s:io.kubernetes.pod.namespace: paperless
@@ -55,6 +66,17 @@ spec:
         - ports:
             - port: "9000"
               protocol: TCP
+    # The protonmail-bridge sidecar shares this pod's identity, so its API calls
+    # to Proton leave through this policy. toFQDNs is the tighter option but it
+    # only installs the 443 rule while the DNS proxy still caches the name; if
+    # the vault ever goes quiet past the record TTL, egress silently stops.
+    # world:443 avoids that, at the cost of not restricting the destination.
+    - toEntities:
+        - world
+      toPorts:
+        - ports:
+            - port: "443"
+              protocol: TCP
 ---
 apiVersion: cilium.io/v2
