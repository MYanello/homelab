# vim: set ft=dockerfile

FROM rust:1.99.1-slim-trixie@sha256:f6c4a35d21dbb3c89d7a8d056c193e94fc09037f2b58dd858b09c39a47dd02d7 AS harmonia-build
ARG HARMONIA_REF=harmonia-v3.3.0
WORKDIR /src
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential pkg-config git xz-utils \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch ${HARMONIA_REF} https://github.com/nix-community/harmonia .
RUN cargo build --release -p harmonia-cache -p harmonia-store-gc


FROM debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-server nix-bin \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -d /home/nix -s /bin/sh nix \
    && install -d -m 0755 /run/sshd \
    && install -d -m 0700 -o nix -g nix /home/nix/.ssh \
    && rm -f /etc/ssh/ssh_host_*
COPY <<EOF /etc/ssh/sshd_config.d/90-cache.conf
AllowUsers nix
PermitRootLogin no
PasswordAuthentication no
PubkeyAuthentication yes
EOF

COPY --from=harmonia-build /src/target/release/harmonia-cache /usr/local/bin/harmonia-cache
COPY --from=harmonia-build /src/target/release/harmonia-gc /usr/local/bin/harmonia-gc
COPY entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/entrypoint.sh
EXPOSE 22 5000
CMD ["/usr/local/bin/entrypoint.sh"]
