{
  "title": "Kubernetes / Compute Resources / Cluster(Windows)",
  "editable": false,
  "timezone": "UTC",
  "tags": [
    "kubernetes-mixin",
    "vm-k8s-stack"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {
          "selected": true,
          "text": "default",
          "value": "default"
        },
        "regex": ""
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "constant",
        "query": ".*",
        "definition": ".*",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "multi": false,
        "includeAll": false,
        "hide": 2,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "title": "CPU Utilisation",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - avg(rate(windows_cpu_time_total{cluster=~\"$cluster\",job=\"kubernetes-windows-exporter\",mode=\"idle\"}[$__rate_interval])) by(cluster)",
          "instant": true
        }
      ],
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "interval": "1m",
      "options": {
        "colorMode": "none"
      },
      "pluginVersion": "v13.0.0",
      "type": "stat"
    },
    {
      "title": "CPU Requests Commitment",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(kube_pod_windows_container_resource_cpu_cores_request{cluster=~\"$cluster\"}) by(cluster) / sum(node:windows_node_num_cpu:sum{cluster=~\"$cluster\"}) by(cluster)",
          "instant": true
        }
      ],
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "id": 2,
      "interval": "1m",
      "options": {
        "colorMode": "none"
      },
      "pluginVersion": "v13.0.0",
      "type": "stat"
    },
    {
      "title": "CPU Limits Commitment",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(kube_pod_windows_container_resource_cpu_cores_limit{cluster=~\"$cluster\"}) by(cluster) / sum(node:windows_node_num_cpu:sum{cluster=~\"$cluster\"}) by(cluster)",
          "instant": true
        }
      ],
      "datasource": {
        "type": "datasource",
