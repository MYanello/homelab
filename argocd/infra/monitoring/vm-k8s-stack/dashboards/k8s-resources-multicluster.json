{
  "title": "Kubernetes / Compute Resources /  Multi-Cluster",
  "editable": false,
  "timezone": "UTC",
  "tags": [
    "kubernetes-mixin",
    "vm-k8s-stack"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {
          "selected": true,
          "text": "default",
          "value": "default"
        },
        "regex": ""
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "constant",
        "query": ".*",
        "multi": false,
        "includeAll": false,
        "hide": 2,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "title": "CPU Utilisation",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(cluster:node_cpu:ratio_rate5m) by(cluster) / count(cluster:node_cpu:ratio_rate5m) by(cluster)",
          "instant": true
        }
      ],
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "interval": "1m",
      "options": {
        "colorMode": "none"
      },
      "pluginVersion": "v13.0.0",
      "type": "stat"
    },
    {
      "title": "CPU Requests Commitment",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(kube_pod_container_resource_requests{job=\"kube-state-metrics\",resource=\"cpu\",cluster=~\"$cluster\"}) by(cluster) / sum(kube_node_status_allocatable{job=\"kube-state-metrics\",resource=\"cpu\",cluster=~\"$cluster\"}) by(cluster)",
          "instant": true
        }
      ],
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "id": 2,
      "interval": "1m",
      "options": {
        "colorMode": "none"
      },
      "pluginVersion": "v13.0.0",
      "type": "stat"
    },
    {
      "title": "CPU Limits Commitment",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(kube_pod_container_resource_limits{job=\"kube-state-metrics\",resource=\"cpu\",cluster=~\"$cluster\"}) by(cluster) / sum(kube_node_status_allocatable{job=\"kube-state-metrics\",resource=\"cpu\",cluster=~\"$cluster\"}) by(cluster)",
