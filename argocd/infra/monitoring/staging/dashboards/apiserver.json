          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(workqueue_adds_total{job=\"apiserver\",instance=~\"$instance\",cluster=~\"$cluster\"}[$__rate_interval])) by(instance,name,cluster)",
