          "expr": "histogram_quantile(0.99, sum(rate(workqueue_queue_duration_seconds_bucket{job=\"apiserver\",instance=~\"$instance\",cluster=~\"$cluster\"}[$__rate_interval])) by(instance,name,le,cluster))",
