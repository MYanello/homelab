{
  "title": "Kubernetes / USE Method / Node(Windows)",
  "editable": false,
  "timezone": "UTC",
  "tags": [
    "kubernetes-mixin",
    "vm-k8s-stack"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {
          "selected": true,
          "text": "default",
          "value": "default"
        },
        "regex": ""
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "constant",
        "query": ".*",
        "definition": ".*",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "multi": false,
        "includeAll": false,
        "hide": 2,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "instance",
        "label": "instance",
        "type": "query",
        "query": "label_values(windows_system_boot_time_timestamp_seconds{cluster=~\"$cluster\"}, instance)",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "hide": 0,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "title": "CPU Utilisation",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node:windows_node_cpu_utilisation:avg1m{cluster=~\"$cluster\",instance=\"$instance\"}",
          "legendFormat": "Utilisation"
        }
      ],
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "interval": "1m",
      "options": {
        "legend": {
          "asTable": true,
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "pluginVersion": "v13.0.0",
      "type": "timeseries"
    },
    {
      "title": "CPU Usage Per Core",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(irate(windows_cpu_time_total{cluster=~\"$cluster\",job=\"kubernetes-windows-exporter\",mode!=\"idle\",instance=\"$instance\"}[$__rate_interval])) by(core,cluster)",
          "legendFormat": "{{core}}"
        }
      ],
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "interval": "1m",
      "options": {
        "legend": {
          "asTable": true,
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "pluginVersion": "v13.0.0",
      "type": "timeseries"
    },
    {
      "title": "Memory Utilisation %",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node:windows_node_memory_utilisation:{cluster=~\"$cluster\",instance=\"$instance\"}",
          "legendFormat": "Memory"
        }
      ],
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 7
      },
      "id": 3,
      "interval": "1m",
      "options": {
        "legend": {
          "asTable": true,
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "pluginVersion": "v13.0.0",
      "type": "timeseries"
    },
    {
      "title": "Memory Usage",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(windows_os_visible_memory_bytes{cluster=~\"$cluster\",job=\"kubernetes-windows-exporter\",instance=\"$instance\"} - windows_memory_available_bytes{cluster=~\"$cluster\",job=\"kubernetes-windows-exporter\",instance=\"$instance\"}) by(cluster)",
          "legendFormat": "memory used"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(node:windows_node_memory_totalCached_bytes:sum{cluster=~\"$cluster\",instance=\"$instance\"}) by(cluster)",
          "legendFormat": "memory cached"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(windows_memory_available_bytes{cluster=~\"$cluster\",job=\"kubernetes-windows-exporter\",instance=\"$instance\"}) by(cluster)",
          "legendFormat": "memory free"
        }
      ],
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 7
      },
      "id": 4,
      "interval": "1m",
      "options": {
        "legend": {
          "asTable": true,
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "pluginVersion": "v13.0.0",
      "type": "timeseries"
    },
    {
      "title": "Memory Saturation (Swap I/O) Pages",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node:windows_node_memory_swap_io_pages:irate{cluster=~\"$cluster\",instance=\"$instance\"}",
          "legendFormat": "Swap IO"
        }
      ],
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 7,
