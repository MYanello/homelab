      "options": {
        "legend": {
          "asTable": true,
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "pluginVersion": "v13.0.0",
      "type": "timeseries"
    },
    {
      "title": "Disk IO Utilisation",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node:windows_node_disk_utilisation:avg_irate{cluster=~\"$cluster\",instance=\"$instance\"}",
          "legendFormat": "Utilisation"
        }
      ],
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
