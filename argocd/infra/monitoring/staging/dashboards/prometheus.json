{
  "title": "Prometheus / Overview",
  "editable": false,
  "timezone": "utc",
  "tags": [
    "prometheus-mixin",
    "vm-k8s-stack"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {
          "selected": false,
          "text": "default",
          "value": "default"
        }
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "constant",
        "query": ".*",
        "definition": ".*",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "multi": false,
        "includeAll": false,
        "hide": 2,
        "allValue": ".+",
        "current": {
          "selected": false,
          "text": [
            "$__all"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 2
      },
      {
        "name": "job",
        "label": "job",
        "type": "query",
        "query": "label_values(prometheus_build_info{cluster=~\"$cluster\"}, job)",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "refresh": 2,
        "sort": 2
      },
      {
        "name": "instance",
        "label": "instance",
        "type": "query",
        "query": "label_values(prometheus_build_info{cluster=~\"$cluster\",job=~\"$job\"}, instance)",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "refresh": 2,
        "sort": 2
      }
    ]
  },
  "panels": [
    {
      "title": "Prometheus Stats",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "type": "row"
    },
    {
      "title": "Prometheus Stats",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "count(prometheus_build_info{cluster=~\"$cluster\",job=~\"$job\",instance=~\"$instance\"}) by(cluster,job,instance,version)",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "max(time() - process_start_time_seconds{cluster=~\"$cluster\",job=~\"$job\",instance=~\"$instance\"}) by(cluster,job,instance)",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "displayName": "",
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Time"
              },
              {
                "id": "custom.align",
                "value": null
              },
              {
                "id": "custom.hidden",
                "value": "true"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cluster"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": null
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "displayName",
                "value": "Cluster"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "job"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": null
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "displayName",
                "value": "Job"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "instance"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Instance"
              },
              {
                "id": "custom.align",
                "value": null
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "version"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Version"
              },
              {
                "id": "custom.align",
                "value": null
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Count"
              },
              {
                "id": "custom.align",
                "value": null
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.hidden",
                "value": "true"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Uptime"
              },
              {
                "id": "custom.align",
                "value": null
              },
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "pluginVersion": "v13.0.0",
      "type": "table"
    },
    {
      "title": "Discovery",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "type": "row"
    },
    {
      "title": "Target Sync",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "sum(rate(prometheus_target_sync_length_seconds_sum{cluster=~\"$cluster\",job=~\"$job\",instance=~\"$instance\"}[5m])) by(cluster,job,scrape_job,instance) * 1e3",
          "format": "time_series",
          "legendFormat": "{{cluster}}:{{job}}:{{instance}}:{{scrape_job}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0,
          "unit": "ms"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 4,
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "v13.0.0",
      "type": "timeseries"
    },
    {
      "title": "Targets",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "sum(prometheus_sd_discovered_targets{cluster=~\"$cluster\",job=~\"$job\",instance=~\"$instance\"}) by(cluster,job,instance)",
          "format": "time_series",
          "legendFormat": "{{cluster}}:{{job}}:{{instance}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 100,
            "lineWidth": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0,
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 5,
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "v13.0.0",
      "type": "timeseries"
    },
    {
      "title": "Retrieval",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 6,
      "type": "row"
    },
    {
      "title": "Average Scrape Interval Duration",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "(rate(prometheus_target_interval_length_seconds_sum{cluster=~\"$cluster\",job=~\"$job\",instance=~\"$instance\"}[5m]) / rate(prometheus_target_interval_length_seconds_count{cluster=~\"$cluster\",job=~\"$job\",instance=~\"$instance\"}[5m])) * 1e3",
          "format": "time_series",
          "legendFormat": "{{cluster}}:{{job}}:{{instance}} {{interval}} configured"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0,
          "unit": "ms"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 17
      },
      "id": 7,
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "v13.0.0",
      "type": "timeseries"
    },
    {
      "title": "Scrape failures",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "sum(rate(prometheus_target_scrapes_exceeded_body_size_limit_total{cluster=~\"$cluster\",job=~\"$job\",instance=~\"$instance\"}[1m])) by(cluster,job,instance)",
          "format": "time_series",
          "legendFormat": "exceeded body size limit: {{cluster}} {{job}} {{instance}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "sum(rate(prometheus_target_scrapes_exceeded_sample_limit_total{cluster=~\"$cluster\",job=~\"$job\",instance=~\"$instance\"}[1m])) by(cluster,job,instance)",
          "format": "time_series",
          "legendFormat": "exceeded sample limit: {{cluster}} {{job}} {{instance}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "sum(rate(prometheus_target_scrapes_sample_duplicate_timestamp_total{cluster=~\"$cluster\",job=~\"$job\",instance=~\"$instance\"}[1m])) by(cluster,job,instance)",
          "format": "time_series",
          "legendFormat": "duplicate timestamp: {{cluster}} {{job}} {{instance}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "sum(rate(prometheus_target_scrapes_sample_out_of_bounds_total{cluster=~\"$cluster\",job=~\"$job\",instance=~\"$instance\"}[1m])) by(cluster,job,instance)",
          "format": "time_series",
          "legendFormat": "out of bounds: {{cluster}} {{job}} {{instance}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "sum(rate(prometheus_target_scrapes_sample_out_of_order_total{cluster=~\"$cluster\",job=~\"$job\",instance=~\"$instance\"}[1m])) by(cluster,job,instance)",
          "format": "time_series",
          "legendFormat": "out of order: {{cluster}} {{job}} {{instance}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 100,
            "lineWidth": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0,
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 17
      },
      "id": 8,
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "v13.0.0",
      "type": "timeseries"
    },
    {
      "title": "Appended Samples",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "rate(prometheus_tsdb_head_samples_appended_total{cluster=~\"$cluster\",job=~\"$job\",instance=~\"$instance\"}[5m])",
          "format": "time_series",
          "legendFormat": "{{cluster}} {{job}} {{instance}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 100,
            "lineWidth": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0,
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 17
      },
      "id": 9,
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "v13.0.0",
      "type": "timeseries"
    },
    {
      "title": "Storage",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 10,
      "type": "row"
    },
    {
      "title": "Head Series",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "prometheus_tsdb_head_series{cluster=~\"$cluster\",job=~\"$job\",instance=~\"$instance\"}",
          "format": "time_series",
          "legendFormat": "{{cluster}} {{job}} {{instance}} head series"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 100,
            "lineWidth": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0,
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "id": 11,
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "v13.0.0",
      "type": "timeseries"
    },
    {
      "title": "Head Chunks",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "prometheus_tsdb_head_chunks{cluster=~\"$cluster\",job=~\"$job\",instance=~\"$instance\"}",
          "format": "time_series",
          "legendFormat": "{{cluster}} {{job}} {{instance}} head chunks"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
