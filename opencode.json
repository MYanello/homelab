{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "vmlogs": {
        "type": "remote",
        "url": "https://vmlogs-mcp.yanello.net/mcp"
      },
      "vmetrics": {
        "type": "remote",
        "url": "https://vm-mcp.yanello.net/mcp"
      },
      "kagi": {
        "type": "remote",
        "url": "https://mcp.kagi.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:KAGI_API_KEY}"
        }
      }
    }
  }
}
